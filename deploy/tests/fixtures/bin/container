#!/bin/bash

set -eu

STATE_DIR="${FAKE_CONTAINER_STATE:?FAKE_CONTAINER_STATE is required}"
mkdir -p \
    "${STATE_DIR}/containers" \
    "${STATE_DIR}/container-images" \
    "${STATE_DIR}/mount-destinations" \
    "${STATE_DIR}/mount-sources" \
    "${STATE_DIR}/images" \
    "${STATE_DIR}/running" \
    "${STATE_DIR}/networks" \
    "${STATE_DIR}/volumes" \
    "${STATE_DIR}/unowned/container" \
    "${STATE_DIR}/unowned/network" \
    "${STATE_DIR}/unowned/volume"

list_names() {
    local directory=$1
    local path

    for path in "${directory}"/*; do
        [[ -e "${path}" ]] || continue
        basename "${path}"
    done
}

last_argument() {
    local value=""

    for value in "$@"; do :; done
    printf '%s\n' "${value}"
}

inspect_resource() {
    local resource_type=$1
    local resource_name=$2
    local label_value="apple-container"
    local address="192.168.65.4/24"
    local image="ghcr.io/luckykuang/sub2api-plus:latest"
    local mounts="[]"

    if [[ -e "${STATE_DIR}/unowned/${resource_type}/${resource_name}" ]]; then
        label_value="other"
    fi
    case "${resource_name}" in
        sub2api-apple-postgres) address="192.168.65.2/24" ;;
        sub2api-apple-redis) address="192.168.65.3/24" ;;
    esac
    if [[ -f "${STATE_DIR}/container-images/${resource_name}" ]]; then
        image="$(<"${STATE_DIR}/container-images/${resource_name}")"
    fi
    if [[ -f "${STATE_DIR}/mount-sources/${resource_name}" ]]; then
        mounts="$(printf '[{"source":"%s","destination":"%s"}]' \
            "$(<"${STATE_DIR}/mount-sources/${resource_name}")" \
            "$(<"${STATE_DIR}/mount-destinations/${resource_name}")")"
    fi

    printf '[{"configuration":{"labels":{"org.sub2api.stack":"%s"},"image":{"reference":"%s"},"mounts":%s},"status":{"networks":[{"ipv4Address":"%s"}]}}]\n' \
        "${label_value}" "${image}" "${mounts}" "${address}"
}

image_digest() {
    local image=$1

    if [[ "${image}" == "localhost/sub2api-apple-rollback:previous" ]]; then
        [[ -f "${STATE_DIR}/images/rollback-digest" ]] || return 1
        cat "${STATE_DIR}/images/rollback-digest"
    elif [[ -f "${STATE_DIR}/images/current-digest" ]]; then
        cat "${STATE_DIR}/images/current-digest"
    else
        printf '%s\n' "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    fi
}

command=${1-}
if [[ $# -gt 0 ]]; then shift; fi
printf '%s %s\n' "${command}" "$*" >>"${STATE_DIR}/commands.log"

case "${command}" in
    --version)
        echo "container CLI version 1.1.0 (build: release, commit: fake)"
        ;;
    system)
        subcommand=${1-}
        case "${subcommand}" in
            status) [[ -e "${STATE_DIR}/system-running" ]] ;;
            start) touch "${STATE_DIR}/system-running" ;;
            stop) rm -f "${STATE_DIR}/system-running" "${STATE_DIR}/running"/* ;;
            df)
                printf '%s\n' "TYPE TOTAL ACTIVE SIZE RECLAIMABLE"
                printf '%s\n' "Images 4 4 1GB 0B"
                ;;
            *) exit 1 ;;
        esac
        ;;
    list)
        include_all=false
        for argument in "$@"; do
            [[ "${argument}" == "--all" || "${argument}" == "-a" ]] && include_all=true
        done
        if [[ "${include_all}" == true ]]; then
            list_names "${STATE_DIR}/containers"
        else
            list_names "${STATE_DIR}/running"
        fi
        ;;
    network)
        subcommand=${1-}
        shift || true
        case "${subcommand}" in
            list)
                echo default
                list_names "${STATE_DIR}/networks"
                ;;
            create) touch "${STATE_DIR}/networks/$(last_argument "$@")" ;;
            inspect) inspect_resource network "${1}" ;;
            delete) rm -f "${STATE_DIR}/networks/${1}" ;;
            *) exit 1 ;;
        esac
        ;;
    volume)
        subcommand=${1-}
        shift || true
        case "${subcommand}" in
            list) list_names "${STATE_DIR}/volumes" ;;
            create) touch "${STATE_DIR}/volumes/$(last_argument "$@")" ;;
            inspect) inspect_resource volume "${1}" ;;
            delete) rm -f "${STATE_DIR}/volumes/${1}" ;;
            *) exit 1 ;;
        esac
        ;;
    image)
        subcommand=${1-}
        shift || true
        case "${subcommand}" in
            inspect)
                digest="$(image_digest "${1}")" || exit 1
                printf '[{"configuration":{"descriptor":{"digest":"%s"}}}]\n' "${digest}"
                ;;
            pull)
                image="$(last_argument "$@")"
                if [[ "${image}" == *"sub2api-plus"* && -f "${STATE_DIR}/images/fail-next-pull" ]]; then
                    exit 1
                fi
                if [[ "${image}" == *"sub2api-plus"* && -f "${STATE_DIR}/images/next-digest" ]]; then
                    mv "${STATE_DIR}/images/next-digest" "${STATE_DIR}/images/current-digest"
                fi
                ;;
            tag)
                digest="$(image_digest "${1}")" || exit 1
                [[ "${2-}" == "localhost/sub2api-apple-rollback:previous" ]] || exit 1
                printf '%s\n' "${digest}" >"${STATE_DIR}/images/rollback-digest"
                ;;
            delete)
                image=${1-}
                if [[ "${image}" == "localhost/sub2api-apple-rollback:previous" ]]; then
                    rm -f "${STATE_DIR}/images/rollback-digest"
                fi
                printf '%s\n' "${image}" >>"${STATE_DIR}/deleted-images.log"
                ;;
            prune)
                touch "${STATE_DIR}/images-pruned"
                ;;
            *) exit 1 ;;
        esac
        ;;
    create)
        name=""
        image=""
        mount_source=""
        mount_destination=""
        printf '%s\n' "$*" >>"${STATE_DIR}/create-args.log"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --name)
                    name=$2
                    shift 2
                    ;;
                --mount)
                    mount_source=${2#*source=}
                    mount_source=${mount_source%%,target=*}
                    mount_destination=${2##*target=}
                    mount_destination=${mount_destination%%,*}
                    shift 2
                    ;;
                --volume)
                    mount_source=${2%%:*}
                    mount_destination=${2#*:}
                    mount_destination=${mount_destination%%:*}
                    shift 2
                    ;;
                --label|--network|--platform|--ulimit|--env-file|--entrypoint|--publish)
                    shift 2
                    ;;
                --*)
                    shift
                    ;;
                *)
                    if [[ -z "${image}" ]]; then
                        image=$1
                    fi
                    shift
                    ;;
            esac
        done
        [[ -n "${name}" ]]
        touch "${STATE_DIR}/containers/${name}"
        printf '%s\n' "${image}" >"${STATE_DIR}/container-images/${name}"
        if [[ -n "${mount_source}" ]]; then
            printf '%s\n' "${mount_source}" >"${STATE_DIR}/mount-sources/${name}"
            printf '%s\n' "${mount_destination}" >"${STATE_DIR}/mount-destinations/${name}"
        fi
        ;;
    inspect)
        inspect_resource container "${1}"
        ;;
    start)
        touch "${STATE_DIR}/running/${1}"
        ;;
    stop)
        for argument in "$@"; do
            case "${argument}" in
                --time|--signal) skip_next=true ;;
                [0-9]*|SIG*) ;;
                *) rm -f "${STATE_DIR}/running/${argument}" ;;
            esac
        done
        ;;
    delete)
        for argument in "$@"; do
            case "${argument}" in
                --force|-f) ;;
                *)
                    rm -f "${STATE_DIR}/running/${argument}"
                    rm -f "${STATE_DIR}/containers/${argument}"
                    rm -f "${STATE_DIR}/container-images/${argument}"
                    rm -f "${STATE_DIR}/mount-sources/${argument}"
                    rm -f "${STATE_DIR}/mount-destinations/${argument}"
                    ;;
            esac
        done
        ;;
    exec)
        echo 1
        ;;
    logs|copy)
        exit 0
        ;;
    *)
        echo "Unsupported fake container command: ${command} $*" >&2
        exit 1
        ;;
esac
